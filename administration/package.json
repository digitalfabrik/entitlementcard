{
  "name": "administration",
  "private": true,
  "type": "module",
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@cantoo/pdf-lib": "^2.11.1",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/system": "^9.5.0",
    "@mui/types": "^9.5.0",
    "@mui/utils": "^9.5.0",
    "@mui/x-data-grid": "^9.16.0",
    "@mui/x-date-pickers": "^9.16.0",
    "@nivo/bar": "^0.99.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@sentry/react": "^11.8.0",
    "@zxing/library": "^0.23.0",
    "build-configs": "file:../build-configs",
    "csv-parse": "^7.0.2",
    "csv-stringify": "^6.9.0",
    "date-fns": "^4.1.0",
    "graphql": "^17.0.2",
    "html-react-parser": "^6.1.5",
    "i18next": "^26.5.5",
    "localforage": "^1.10.0",
    "motion": "^14.6.0",
    "normalize.css": "^8.0.1",
    "notistack": "^3.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.1",
    "react-router": "^8.5.0",
    "react-to-print": "^3.3.0",
    "temporal-polyfill": "^1.0.6",
    "urql": "^5.0.4",
    "xregexp": "^5.1.2"
  },
  "devDependencies": {
    "@babel/runtime": "^8.0.0",
    "@bufbuild/buf": "^1.75.0",
    "@bufbuild/protoc-gen-es": "^2.13.0",
    "@eslint/compat": "^2.0.4",
    "@eslint/eslintrc": "^3.3.6",
    "@graphql-codegen/add": "^7.1.1",
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/typed-document-node": "^7.2.0",
    "@graphql-codegen/typescript": "^6.1.2",
    "@graphql-codegen/typescript-operations": "^6.1.10",
    "@parcel/watcher": "^2.6.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.13.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/eslint-plugin": "^1.6.27",
    "babel-plugin-transform-react-remove-prop-types": "^0.4.24",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.4",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-jsx-expressions": "^1.3.2",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-unicorn": "^78.0.0",
    "jsdom": "^30.1.3",
    "madge-ts6": "^8.1.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.2.4",
    "vite-plugin-generate-file": "^0.3.1",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "build": "npm run codegen:pb && npm run codegen:gql && vite build",
    "build:dev": "NODE_ENV=development vite build --mode development",
    "codegen:gql": "graphql-codegen --config graphql-codegen.ts",
    "codegen:gql:dev": "graphql-codegen --config graphql-codegen.ts --watch",
    "codegen:pb": "buf generate",
    "check-circular-deps": "bash ./scripts/check_circular_deps.sh",
    "format": "eslint . --fix && prettier . --write",
    "lint": "eslint . && prettier . --check",
    "postinstall": "npm run codegen:pb && npm run codegen:gql",
    "start": "concurrently 'npm run start:dev' 'npm run codegen:gql:dev'",
    "start:dev": "vite --open",
    "start:ci": "vite preview --port 3000",
    "test": "vitest run",
    "test:e2e": "npx playwright test",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "ts:check": "tsc --build"
  },
  "madge": {
    "excludeRegExp": [
      "^project-configs\\/index\\.ts$",
      "^project-configs\\/bayern\\/config\\.ts$"
    ],
    "detectiveOptions": {
      "ts": {
        "skipTypeImports": true
      },
      "tsx": {
        "skipTypeImports": true
      }
    }
  }
}
